input {
    keyboard { xkb { layout "us"; }; }
    touchpad { tap; natural-scroll; }
    focus-follows-mouse max-scroll-amount="0%"
    disable-power-key-handling
}
// Keep one wallpaper behind the workspace stack instead of sliding a copy
// with each workspace. The Quickshell surface already ignores exclusive zones.
layer-rule {
    match namespace="^ohmansy-wallpaper$"
    place-within-backdrop true
}
// Explicit QML regions constrain blur to the glass. Cached wallpaper blur is
// reliable on the VM renderer; non-xray blur currently produces no effect there.
layer-rule {
    match namespace="^ohmansy-bar$"
    popups {
        background-effect {
            blur true
            xray true
        }
    }
}

layer-rule {
    match namespace="^ohmansy-launcher$"
    background-effect {
        blur true
        xray false
    }
}

layout {
    gaps 12
    background-color "transparent"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.83333
    }
    focus-ring {
        off
    }
    // A flat translucent rim on every window; focus changes its strength.
    border {
        // Included configs must enable borders explicitly.
        on
        width 2
        active-color "#d8dce560"
        inactive-color "#b8bec92b"
        urgent-color "#c4a7e780"
    }
    shadow {
        on
        softness 30
        spread 1
        offset x=0 y=6
        // Keep transparent window content clear of the shadow's dark fill.
        draw-behind-window false
        color "#00000060"
        inactive-color "#00000038"
    }
}
cursor { xcursor-theme "Adwaita"; xcursor-size 24; }
prefer-no-csd
spawn-at-startup "mako"
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}
// Bindings are generated from shortcuts.json by desktop.nix.
hotkey-overlay { skip-at-startup; }
