input {
    keyboard { xkb { layout "us"; }; }
    touchpad { tap; natural-scroll; }
    focus-follows-mouse max-scroll-amount="0%"
    disable-power-key-handling
}
// Explicit QML regions constrain blur to the glass. Cached wallpaper blur is
// reliable on the VM renderer; non-xray blur currently produces no effect there.
layer-rule {
    match namespace="^ohmansy-bar$"
    popups {
        background-effect {
            blur true
            xray true
        }
    }
}

layer-rule {
    match namespace="^ohmansy-launcher$"
    background-effect {
        blur true
        xray false
    }
}

layout {
    gaps 12
    background-color "#10131a"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.83333
    }
    focus-ring {
        off
    }
    // A flat translucent rim on every window; focus changes its strength.
    border {
        // Included configs must enable borders explicitly.
        on
        width 2
        active-color "#d8dce560"
        inactive-color "#b8bec92b"
        urgent-color "#c4a7e780"
    }
}
cursor { xcursor-theme "Adwaita"; xcursor-size 24; }
prefer-no-csd
spawn-at-startup "mako"
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}
// Wallpaper blur remains stable in the VM and keeps terminal text opaque.
window-rule {
    match app-id="^foot$"
    background-effect {
        blur true
        xray true
    }
}
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+T hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+Space repeat=false hotkey-overlay-title="Application launcher" { spawn "ohmansy-desktop" "menu" "apps"; }
    Mod+Shift+Space repeat=false hotkey-overlay-title="Find an open window" { spawn "ohmansy-desktop" "menu" "windows"; }
    Mod+E hotkey-overlay-title="File manager" { spawn "nautilus"; }
    Mod+B { spawn "firefox"; }
    Mod+W repeat=false { close-window; }
    Mod+Q repeat=false { close-window; }
    Mod+Tab repeat=false { toggle-overview; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Left { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R { switch-preset-window-height; }
    Mod+Ctrl+Shift+R { switch-preset-window-height-back; }
    Mod+Shift+C { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center visible columns together" { center-visible-columns; }
    Mod+U repeat=false hotkey-overlay-title="Toggle column tabs" { toggle-column-tabbed-display; }
    Mod+I hotkey-overlay-title="Pull window into column" { consume-window-into-column; }
    Mod+O hotkey-overlay-title="Split bottom window into new column" { expel-window-from-column; }
    Mod+Shift+I repeat=false hotkey-overlay-title="Pull window from left into column" { spawn "ohmansy-desktop" "consume-left"; }
    Mod+Shift+O repeat=false hotkey-overlay-title="Split bottom window into column on left" { spawn "ohmansy-desktop" "expel-left"; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Shift+V repeat=false hotkey-overlay-title="Clipboard history" { spawn "ohmansy-desktop" "menu" "clipboard"; }
    Mod+Comma repeat=false hotkey-overlay-title="Desktop controls" { spawn "ohmansy-desktop" "menu" "controls"; }
    Mod+N repeat=false hotkey-overlay-title="Notification history" { spawn "ohmansy-desktop" "menu" "notifications"; }
    Mod+X repeat=false hotkey-overlay-title="Power menu" { spawn "ohmansy-desktop" "menu" "power"; }
    Mod+Alt+L repeat=false hotkey-overlay-title="Lock screen" { spawn "ohmansy-desktop" "lock"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "3%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "3%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+E { quit; }
    Print { screenshot show-pointer=false; }
    Ctrl+Print { screenshot-screen show-pointer=false; }
    Alt+Print { screenshot-window show-pointer=false; }
}
