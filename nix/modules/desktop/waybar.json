{
  "layer": "top",
  "height": 36,
  "spacing": 18,
  "modules-left": ["custom/launcher", "niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "tray"],
  "custom/launcher": {"format": "ohmansy", "on-click": "fuzzel", "tooltip": false},
  "clock": {"format": "{:%a  %H:%M}", "tooltip-format": "{:%Y-%m-%d}"},
  "pulseaudio": {"format": "Volume {volume}%", "format-muted": "Muted"},
  "network": {"format-ethernet": "Connected", "format-wifi": "{essid}", "format-disconnected": "Offline"}
}
