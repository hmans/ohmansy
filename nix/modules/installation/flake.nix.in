{
  inputs.ohmansy.url = "path:@SOURCE@";
  inputs.nixpkgs.follows = "ohmansy/nixpkgs";
  outputs = { nixpkgs, ohmansy, ... }: {
    nixosConfigurations.ohmansy = nixpkgs.lib.nixosSystem {
      system = "@SYSTEM@";
      specialArgs = { inherit ohmansy; };
      modules = [
        ohmansy.nixosModules.default ./configuration.nix ./owner.nix ./preferences.nix
        { system.extraDependencies = [ ohmansy.outPath ]; }
      ];
    };
  };
}
